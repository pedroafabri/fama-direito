---
// src/pages/index.astro
const NOTION_URL =
  "https://app.notion.com/p/Direito-Noturno-2025-2-3bf7d1d61f3f80779348dd5a607ecb34";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${NOTION_URL}`} />
    <title>Redirecionando...</title>
    <script define:vars={{ NOTION_URL }}>
      window.location.replace(NOTION_URL);
    </script>
  </head>
  <body>
    <p>Redirecionando para o Notion...</p>
    <p>Se não for redirecionado, <a href={NOTION_URL}>clique aqui</a>.</p>
  </body>
</html>
